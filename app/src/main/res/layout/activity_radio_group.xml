<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AnswerActivity"
    android:background="@drawable/bg_green1">

    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="@dimen/dp_25"
        android:layout_height="@dimen/dp_25"
        android:src="@drawable/back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/dp_45"
        android:layout_marginStart="@dimen/dp_20"/>

    <ImageView
        android:id="@+id/title_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/title_dtdbg"
        app:layout_constraintBottom_toBottomOf="@+id/btn_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_back"
        android:background="@drawable/title_bg"
        android:padding="@dimen/dp_15"/>

    <TextView
        android:id="@+id/btn_change"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_change"
        android:fontFamily="@font/font_144"
        android:padding="@dimen/dp_4"
        android:paddingStart="@dimen/dp_6"
        android:paddingEnd="@dimen/dp_6"
        android:text="换一个"
        app:layout_constraintBottom_toBottomOf="@+id/title_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/title_bg"
        app:layout_constraintTop_toTopOf="@+id/title_bg"
        app:layout_constraintHorizontal_bias="0.7"/>

    <ImageView
        android:id="@+id/icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_atdbg_main"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bg"
        android:layout_marginTop="@dimen/dp_20"/>

    <TextView
        android:id="@+id/question"
        android:layout_width="@dimen/dp_200"
        android:layout_height="wrap_content"
        android:fontFamily="@font/font_144"
        android:text="唐朝时期的安史之乱
爆发干哪位皇帝统治时期?"
        android:textColor="#007F4A"
        app:layout_constraintEnd_toEndOf="@+id/icon"
        app:layout_constraintStart_toStartOf="@+id/icon"
        app:layout_constraintTop_toTopOf="@+id/icon"
        android:layout_marginTop="@dimen/dp_170"
        android:gravity="center"
        android:textSize="@dimen/sp_18"/>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/subject_tab"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon"
        android:layout_marginTop="@dimen/dp_10"
        app:tabRippleColor="@android:color/transparent"
        app:tabUnboundedRipple="false"
        app:tabIndicatorHeight="0dp" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/option_viewPager"
        android:layout_width="@dimen/dp_200"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/subject_tab"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>