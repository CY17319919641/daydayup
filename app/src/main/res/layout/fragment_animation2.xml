<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".animation_demo.AnimationActivity"
    android:background="@mipmap/bg_animation_in">


    <TextView
        android:id="@+id/animation1"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginStart="@dimen/dp_20"
        android:background="@mipmap/squre_p"
        android:fontFamily="@font/font_144"
        android:gravity="center"
        android:text="动画播放一次"
        android:textColor="@color/white"
        android:textSize="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="@dimen/dp_20"/>

    <TextView
        android:id="@+id/animation2"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center_horizontal"
        android:background="@mipmap/squre_p"
        android:fontFamily="@font/font_144"
        android:gravity="center"
        android:text="动画播放完成播放一次之后，重复播放某一区间"
        android:textColor="@color/white"
        android:textSize="@dimen/dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/animation1" />

    <TextView
        android:id="@+id/animation3"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center_horizontal"
        android:background="@mipmap/squre_p"
        android:fontFamily="@font/font_144"
        android:gravity="center"
        android:text="结束播放"
        android:textColor="@color/white"
        android:textSize="@dimen/dp_12"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/animation2"
        android:layout_marginEnd="@dimen/dp_20"/>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie"
        android:layout_width="@dimen/dp_375"
        android:layout_height="@dimen/dp_500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:lottie_autoPlay="false"
        app:lottie_fileName="retention.json"
        app:lottie_loop="false"
        app:lottie_progress="1" />


</androidx.constraintlayout.widget.ConstraintLayout>